{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@ai/persona-config": ["packages/persona-config/src"],
      "@ai/persona-config/*": ["packages/persona-config/src/*"]
    }
  },
  "include": ["packages/**/*", "apps/**/*"]
}
